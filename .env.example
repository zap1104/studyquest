# StudyQuest environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. `studyquest/settings.py` loads it automatically.

# ---------------------------------------------------------------
# Required
# ---------------------------------------------------------------

# Django signing key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# The application refuses to start if this is missing while DEBUG is off.
DJANGO_SECRET_KEY=

# Gemini API key used for AI course generation.
GEMINI_API_KEY=

# ---------------------------------------------------------------
# Environment
# ---------------------------------------------------------------

# "True" for local development, "False" (or unset) for anything deployed.
# When off, HTTPS redirect, secure cookies and HSTS are enabled automatically.
DEBUG=True

# Comma-separated host list. Add your machine's LAN IP here (not in source)
# when testing from a physical phone:
#   ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.65
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------

# Failed-login throttle for the login/signup portal.
# LOGIN_THROTTLE_MAX_ATTEMPTS=10
# LOGIN_THROTTLE_WINDOW_SECONDS=300